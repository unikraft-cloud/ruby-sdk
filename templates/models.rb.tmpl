{{- /* The models of one API surface: a frozen constants module per enum, and a
  Unikraft::Cloud::Model subclass per object schema. Ruby resolves the nested
  model types by name when a model is built, so the order of the classes does
  not matter. A schema that is neither (a union of scalars without an enum
  branch) is left out: its values stay plain. */ -}}
{{- $module := .Var "module" "Platform" -}}
{{- /* Schemas by name: a reference the preprocessor hoisted carries no
       resolved value, so it is looked up here. */ -}}
{{- $schemas := dict -}}
{{- range $m := .Models }}{{ $_ := set $schemas $m.SchemaName $m.Schema }}{{ end -}}
{{- range $m := .Models }}
{{- if not (regexMatch "^[A-Z][A-Za-z0-9_]*$" $m.SchemaName) }}
{{- fail (printf "schema %q cannot name a Ruby constant; rename it in the specification" $m.SchemaName) }}
{{- end }}
{{- end -}}
