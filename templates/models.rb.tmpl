        module Models
{{- $first := true }}
{{- range $m := .Models }}
{{- $schema := $m.Schema }}
{{- $name := $m.SchemaName }}
{{- /* Enumerations: closed (`enum`) or open (a union with enum branches). */ -}}
{{- $values := list }}
{{- if $schema.Enum }}{{ $values = $schema.Enum }}
{{- else if not $schema.Properties }}
{{- range $branch := concat $schema.AnyOf $schema.OneOf }}{{ with $branch.Value }}{{ range .Enum }}{{ $values = append $values . }}{{ end }}{{ end }}{{ end }}
{{- end }}
{{- if $values }}
{{- if not $first }}
{{ end }}{{ $first = false }}
{{ template "doc" (list (default (printf "The `%s` enumeration." $name) $schema.Description) "          ") }}          module {{ $name }}
{{- $consts := list }}
{{- range $v := $values }}
{{- $const := screamingsnakecase (printf "%v" $v) }}
{{- if not (regexMatch "^[A-Z]" $const) }}{{ $const = printf "V_%s" $const }}{{ end }}
{{- if has $const $consts }}{{ fail (printf "enum %s: two values render the constant %s" $name $const) }}{{ end }}
{{- $consts = append $consts $const }}
            {{ $const }} = {{ if kindIs "string" $v }}{{ printf "%q" $v }}{{ else }}{{ $v }}{{ end }}
{{- end }}

            # Every value of this enumeration.
            ALL = [{{ join ", " $consts }}].freeze
          end
{{- else if or $schema.Properties $schema.AllOf (and $schema.Type ($schema.Type.Is "object")) }}
{{- if not $first }}
{{ end }}{{ $first = false }}
{{ template "doc" (list (default (printf "The `%s` model." $name) $schema.Description) "          ") }}          class {{ $name }} < Unikraft::Cloud::Model
{{- range $prop := propertyNamesOrdered $name $schema }}
{{- /* Find the property's reference: on the schema, or in a branch of its
       composition (two levels deep, as the control-plane spec nests a oneOf
       in an allOf). */ -}}
{{- $ref := index $schema.Properties $prop }}
{{- if not $ref }}
{{- range $part := concat $schema.AllOf $schema.OneOf $schema.AnyOf }}{{ if and (not $ref) $part.Value }}
{{- with index $part.Value.Properties $prop }}{{ $ref = . }}{{ end }}
{{- range $sub := concat $part.Value.AllOf $part.Value.OneOf $part.Value.AnyOf }}{{ if and (not $ref) $sub.Value }}
{{- with index $sub.Value.Properties $prop }}{{ $ref = . }}{{ end }}
{{- end }}{{ end }}
{{- end }}{{ end }}
{{- end }}
{{- $p := getProperty $schema $prop }}
{{- $type := "" }}{{ $array := false }}{{ $map := false }}{{ $yard := "Object" }}
{{- if $ref }}
{{- /* `allOf: [$ref]` is how a description is attached to a reference. */ -}}
{{- if and (not $ref.Ref) $ref.Value (eq (len $ref.Value.AllOf) 1) }}{{ $ref = index $ref.Value.AllOf 0 }}{{ end }}
{{- $target := $ref }}
{{- if and (not $ref.Ref) $ref.Value $ref.Value.Items }}{{ $target = $ref.Value.Items }}{{ $array = true }}
{{- else if and (not $ref.Ref) $ref.Value $ref.Value.AdditionalProperties.Schema }}{{ $target = $ref.Value.AdditionalProperties.Schema }}{{ $map = true }}
{{- end }}
{{- $tv := $target.Value }}
{{- if and $target.Ref (not $tv) }}{{ $tv = get $schemas (refName $target.Ref) }}{{ end }}
{{- with $tv }}{{ with .Type }}
{{- if .Is "string" }}{{ $yard = "String" }}
{{- else if .Is "integer" }}{{ $yard = "Integer" }}
{{- else if .Is "number" }}{{ $yard = "Numeric" }}
{{- else if .Is "boolean" }}{{ $yard = "Boolean" }}
{{- else if .Is "array" }}{{ $yard = "Array" }}
{{- else if .Is "object" }}{{ $yard = "Hash" }}
{{- end }}
{{- end }}{{ end }}
{{- if and $target.Ref $tv (not $tv.Enum) (or $tv.Properties $tv.AllOf (and $tv.Type ($tv.Type.Is "object"))) }}
{{- $type = refName $target.Ref }}{{ $yard = $type }}
{{- end }}
{{- if $array }}{{ $yard = printf "Array<%s>" $yard }}{{ else if $map }}{{ $yard = printf "Hash{Symbol => %s}" $yard }}{{ end }}
{{- end }}
{{- $reader := snakecase $prop }}
{{- if not (regexMatch "^[a-z_][a-z0-9_]*$" $reader) }}
{{- fail (printf "schema %s: property %q cannot name a Ruby reader; rename it in the specification" $name $prop) }}
{{- end }}
            # @!attribute [r] {{ $reader }}
            #   @return [{{ $yard }}, nil]{{ with $p }}{{ with .Description }} {{ regexReplaceAll "[ \t]+\n" (wrapComment . 1000 "            #     ") "\n" }}{{ end }}{{ end }}
            attribute :{{ $reader }}
{{- if $type }}, {{ printf "%q" $type }}{{ end }}
{{- if and $type $array }}, array: true{{ end }}
{{- if and $type $map }}, map: true{{ end }}
{{- if ne $reader $prop }}, key: {{ printf "%q" $prop }}{{ end }}
{{- end }}
          end
{{- end }}
{{- end }}
        end
      end
    end
  end
end
