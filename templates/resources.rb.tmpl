{{- $callOptions := list "body" "options" "headers" "base_url" "timeout" -}}
{{- range $op := $ops }}
{{- if not $op.Operation.Tags }}
{{- fail (printf "%s %s has no tag, so no generated class can expose it" $op.Method $op.Path) }}
{{- end }}
{{- $method := snakecase $op.Operation.OperationID }}
{{- if or (not (regexMatch "^[a-z_][a-z0-9_]*$" $method)) (has $method $keywords) (has $method $objectMethods) }}
{{- fail (printf "operation %q cannot name a Ruby method; rename it in the specification" $op.Operation.OperationID) }}
{{- end }}
{{- range $p := concat (pathParameters $op) (queryParameters $op) }}
{{- if or (not (regexMatch "^[a-z_][a-z0-9_]*$" $p.Name)) (has $p.Name $keywords) (has $p.Name $callOptions) }}
{{- fail (printf "%s %s: parameter %q cannot name a Ruby keyword argument; rename it in the specification" $op.Method $op.Path $p.Name) }}
{{- end }}
{{- end }}
{{- range $p := concat $op.Operation.Parameters $op.PathItem.Parameters }}{{ with $p.Value }}
{{- if or (eq .In "header") (eq .In "cookie") }}
{{- fail (printf "%s %s: %s parameter %q is not supported by the templates" $op.Method $op.Path .In .Name) }}
{{- end }}
{{- end }}{{ end }}
{{- end -}}
