       methods every object has, and the per-call options of the transport. */ -}}
{{- $keywords := list "alias" "and" "begin" "break" "case" "class" "def" "defined" "do" "else" "elsif" "end" "ensure" "false" "for" "if" "in" "module" "next" "nil" "not" "or" "redo" "rescue" "retry" "return" "self" "super" "then" "true" "undef" "unless" "until" "when" "while" "yield" -}}
